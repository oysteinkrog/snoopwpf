<Application x:Class="SnoopWPF.SampleApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- App-level resource — overridden at window level for resource-shadowing test -->
        <SolidColorBrush x:Key="AccentBrush" Color="SteelBlue" />
        <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    x:Key="AppTitle">
            SnoopWPF Sample App
        </sys:String>
    </Application.Resources>
</Application>

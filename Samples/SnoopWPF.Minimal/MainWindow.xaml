<Window x:Class="SnoopWPF.Minimal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnoopWPF Minimal Sample"
        Width="400"
        Height="200">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <TextBlock Margin="0 0 0 8"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   Text="SnoopWPF MCP agent is running on stdio." />
        <TextBlock Margin="0 0 0 12"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   Text="Point an MCP client at this process to inspect this window." />
        <Button Padding="12 4"
                HorizontalAlignment="Center"
                Content="Click me" />
    </StackPanel>
</Window>
